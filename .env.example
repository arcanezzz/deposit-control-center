# Optional overrides — docker compose works WITHOUT a .env file (defaults are built in).
# Copy to .env only if you need to change something (e.g. a host port that is already taken).
# These are local development values only — no real secrets.

POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_dev
POSTGRES_DB=deposits

# Host ports
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9094
KAFKA_UI_HOST_PORT=8081
ADMINER_HOST_PORT=8082

LOG_LEVEL=INFO
